# Username publik TikTok yang sedang live, boleh pakai @ atau tanpa @.
TIKTOK_USERNAME=@username_kamu

# API key Euler Stream untuk tanda tangan request TikTok webcast.
# Isi hanya jika ingin konek ke live sungguhan. Mode --mock tidak memerlukannya.
SIGN_API_KEY=
# Alias opsional; dipakai bila SIGN_API_KEY kosong.
EULER_API_KEY=

# Jembatan data lokal. Jangan bind ke 0.0.0.0.
WS_HOST=127.0.0.1
WS_PORT=8080

# Target koin sesi yang dikirim ke overlay saat pertama tersambung.
TARGET_COINS=500

# Log sesi JSONL (tanpa URL avatar).
LOG_DIR=logs

# Backoff reconnect connector.
RECONNECT_BASE_SECONDS=5
RECONNECT_MAX_SECONDS=30

# Origin overlay untuk avatar contoh pada mode mock.
OVERLAY_ORIGIN=http://127.0.0.1:5173
